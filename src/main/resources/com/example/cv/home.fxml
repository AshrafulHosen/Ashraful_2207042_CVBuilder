<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cv.HomeController"
            prefWidth="800" prefHeight="500">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #009bcc">
            <Label text="Welcome to the CV Builder"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;-fx-text-fill: white"/>

            <Label text="Click the button below to create a new CV."
                   style="-fx-font-size: 16px; -fx-text-fill: #444;"/>

            <Button text="Create New CV" onAction="#handleCreate"
                    style="-fx-font-size: 18px; -fx-padding: 10 20; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
        </VBox>
    </center>

</BorderPane>
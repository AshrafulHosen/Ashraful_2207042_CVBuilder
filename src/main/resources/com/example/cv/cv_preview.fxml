<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv.CVPreviewController">

    <VBox fx:id="previewContainer" spacing="20" style="-fx-padding: 30; -fx-background-color: white;">

        <VBox spacing="10" style="-fx-alignment: center; -fx-background-color: #009bcc">
            <Label fx:id="fullNameLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <HBox spacing="20" style="-fx-alignment: center;">
                <Label fx:id="emailLabel" style="-fx-text-fill: white;" />
                <Label fx:id="phoneLabel" style="-fx-text-fill: white;" />
                <Label fx:id="addressLabel" style="-fx-text-fill: white;" />
            </HBox>
        </VBox>

        <!-- Education Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #009bcc;" text="EDUCATION" />
            <TextArea fx:id="educationPreview" editable="false" prefRowCount="3" style="-fx-background-color: transparent; -fx-border-color: #009bcc; -fx-border-radius: 5; -fx-padding: 10;" wrapText="true" />
        </VBox>

        <!-- Skills Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #009bcc;" text="SKILLS" />
            <TextArea fx:id="skillsPreview" editable="false" prefRowCount="3" style="-fx-background-color: transparent; -fx-border-color: #009bcc; -fx-border-radius: 5; -fx-padding: 10;" wrapText="true" />
        </VBox>

        <!-- Experience Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #009bcc;" text="WORK EXPERIENCE" />
            <TextArea fx:id="experiencePreview" editable="false" prefRowCount="4" style="-fx-background-color: transparent; -fx-border-color: #009bcc; -fx-border-radius: 5; -fx-padding: 10;" wrapText="true" />
        </VBox>

        <!-- Projects Section -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #009bcc;" text="PROJECTS" />
            <TextArea fx:id="projectsPreview" editable="false" prefRowCount="4" style="-fx-background-color: transparent; -fx-border-color: #009bcc; -fx-border-radius: 5; -fx-padding: 10;" wrapText="true" />
        </VBox>

        <!-- Action Buttons -->
        <HBox spacing="15" style="-fx-alignment: center; -fx-padding: 20 0 0 0;">
            <Button onAction="#handleBackToForm" style="-fx-font-size: 14px; -fx-padding: 8 15; -fx-background-color: #95a5a6; -fx-text-fill: white;" text="Back to Form" />
            <Button onAction="#handleBackToHome" style="-fx-font-size: 14px; -fx-padding: 8 15; -fx-background-color: #27ae60; -fx-text-fill: white;" text="Back to Home" />
        </HBox>

    </VBox>

</ScrollPane>

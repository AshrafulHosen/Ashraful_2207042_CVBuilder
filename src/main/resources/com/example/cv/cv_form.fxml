<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.cv.CVFormController">

    <VBox spacing="15" style="-fx-padding: 20;">

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Create Your CV" />

        <!-- Personal Information -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Personal Information" />

        <TextField fx:id="fullNameField" promptText="Full Name" />
        <TextField fx:id="emailField" promptText="Email Address" />
        <TextField fx:id="phoneField" promptText="Phone Number" />
        <TextField fx:id="addressField" promptText="Address" />

        <!-- Education -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Educational Qualifications" />
        <TextArea fx:id="educationArea" prefRowCount="4" promptText="Enter your educational qualifications..." />
      <Label text="Skills">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
        <TextArea fx:id="skillsArea" prefRowCount="4" promptText="Enter your skills..." />

        <!-- Work Experience -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Work Experience" />
        <TextArea fx:id="experienceArea" prefRowCount="4" promptText="Enter your work experience..." />

        <!-- Projects -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Projects" />
        <TextArea fx:id="projectsArea" prefRowCount="4" promptText="Enter your projects..." />

        <!-- Save button or Next button (optional) -->
        <Button style="-fx-font-size: 16px; -fx-padding: 10 20;" text="Generate CV" />

    </VBox>

</ScrollPane>
